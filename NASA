        "\n",
        "import json\n",
        "import os\n",
        "import requests\n",
        "\n",
        "API_URL = \"https://power.larc.nasa.gov/api/temporal/daily/point?parameters=T2M&community=RE&longitude=39.8262&latitude=21.3891&start=20260101&end=20260105&format=JSON\"\n",
        "CACHE_FILE = \"data/local_cache.json\"\n",
        "\n",
        "def fetch_nasa_data():\n",
        "    try:\n",
        "        print(\"🔄 Fetching live data from NASA API...\")\n",
        "        res = requests.get(API_URL, timeout=10)\n",
        "        res.raise_for_status()\n",
        "        data = res.json()\n",
        "        os.makedirs(\"data\", exist_ok=True)\n",
        "        with open(CACHE_FILE, \"w\") as f:\n",
        "            json.dump(data, f, indent=4)\n",
        "        print(\"✅ Data cached successfully.\")\n",
        "        return data\n",
        "    except Exception as e:\n",
        "        print(f\"⚠️ API error ({e}), loading local offline fallback...\")\n",
        "        if os.path.exists(CACHE_FILE):\n",
        "            with open(CACHE_FILE, \"r\") as f:\n",
        "                return json.load(f)\n",
        "        raise RuntimeError(\"No local fallback found!\")\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    data = fetch_nasa_data()\n",
        "    temps = data[\"properties\"][\"parameter\"][\"T2M\"]\n",
        "    print(\"Sample T2M output:\", list(temps.items())[:3])"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# 1. فصل التواريخ ودرجات الحرارة\n",
        "dates = list(temps.keys())\n",
        "temperature_values = list(temps.values())\n",
        "\n",
        "# 2. إنشاء الرسم البياني\n",
        "plt.figure(figsize=(9, 4))\n",
        "plt.plot(dates, temperature_values, marker='o', color='#1f77b4', linewidth=2)\n",
        "\n",
        "# 3. إضافة التنسيقات والعناوين\n",
        "plt.title('NASA POWER: Daily Temperature (Makkah - Jan 2026)', fontsize=12)\n",
        "plt.xlabel('Date (YYYYMMDD)', fontsize=10)\n",
        "plt.ylabel('Temperature (°C)', fontsize=10)\n",
        "plt.grid(True, linestyle='--', alpha=0.6)\n",
        "\n",
        "# 4. عرض الشاشه\n",
        "plt.show()"
